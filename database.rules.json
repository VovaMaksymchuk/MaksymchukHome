{
  "rules": {
    ".read": false,
    ".write": false,

    // ─────────────── дані дашборда ───────────────
    // Читати може лише Google-акаунт зі списку access/viewers
    "home": {
      ".read": "auth != null && root.child('access/viewers/' + auth.uid).val() === true",
      ".write": "auth != null && root.child('access/writers/' + auth.uid).val() === true",

      "live": {
        ".validate": "newData.hasChildren(['ts'])"
      },
      "grid_events": {
        "$sec": {
          ".validate": "$sec.matches(/^[0-9]{10}$/) && newData.child('on').isBoolean()"
        }
      },
      "history": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        }
      },

      // Команди від дашборда (вимикачі світла, уставка опалення). Писати може
      // будь-який переглядач (Google зі списку) — на відміну від решти /home,
      // куди пише лише HA. HA сам читає цей шлях, виконує дію й видаляє запис.
      "commands": {
        // HA (writer) має читати команди, щоб їх виконати
        ".read": "auth != null && root.child('access/writers/' + auth.uid).val() === true",
        ".write": "auth != null && root.child('access/viewers/' + auth.uid).val() === true",
        "switches": {
          "$room": { ".validate": "newData.hasChildren(['on']) && newData.child('on').isBoolean()" }
        },
        "climate": {
          "$id": { ".validate": "newData.child('target').isNumber() && (!newData.hasChild('mode') || newData.child('mode').isString())" }
        }
      }
    },

    // ─────────────── доступ ───────────────
    "access": {
      "viewers": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
